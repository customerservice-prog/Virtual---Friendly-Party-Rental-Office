# Local practice: no integrations and no customer data required.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# Required before any private integration; production requires 16+ characters.
OWNER_PASSWORD=
# Hosted production requires an exact HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=
# Optional model-assisted SHADOW drafts. Set both, then opt in in Connect.
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_DAILY_AI_CALLS=20
# Optional Google OAuth web application (gmail.readonly only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back up separately; loss prevents decrypting the stored Gmail refresh token.
INTEGRATION_ENCRYPTION_KEY=
# Optional explicit NY rental system JSON snapshot endpoint; see docs/INTEGRATIONS.md.
FPR_READONLY_URL=
FPR_READONLY_TOKEN=
# Optional one-repository metadata checks. No write scopes are needed.
GITHUB_READ_REPO=
GITHUB_READ_TOKEN=
# Optional public NY website HTTP/HTML checks; no visual QA or publishing.
ENABLE_WEBSITE_CHECKS=false
